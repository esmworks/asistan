# HTTPS in front of the Leaf Bot server, for the setup docker/install.sh makes (docker/compose.vps.yml).
# Caddy gets and renews the Let's Encrypt certificate for LEAFBOT_DOMAIN by itself; port 80 must be
# reachable from the internet for that.
{
	# Caddy runs on the host's network; its admin API would otherwise listen on the host's loopback.
	admin off
}

{$LEAFBOT_DOMAIN} {
	# Browsers that have once opened the site go straight to HTTPS from then on, so a network in the
	# middle cannot keep them on plain HTTP and read the session cookie. Set after the server's own
	# copy (`>`), so the reply carries it once.
	header >Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{$LEAFBOT_PORT:4319} {
		# Tells the server this request came through the proxy, so it may count sign-in attempts by
		# the address Caddy writes into X-Forwarded-For instead of the proxy's own.
		header_up X-Leafbot-Proxy {$LEAFBOT_PROXY_SECRET}
	}
}
