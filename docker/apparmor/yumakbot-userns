abi <abi/4.0>,
include <tunables/global>

# Lets the YumakBot containers open user namespaces for their bubblewrap sandboxes on hosts that
# restrict them (kernel.apparmor_restrict_unprivileged_userns=1). Everything else stays as without
# a profile; the containers keep their seccomp profile, dropped capabilities and no-new-privileges.
profile yumakbot-userns flags=(unconfined) {
  userns,
}
